<%- include('partials/head') %><% orders.forEach(o=>{ %><section class="card card-body mb-3"><h2 class="h5"><%= o.tracking_no %> · <%= o.status %></h2><p>Pickup: <%= o.pickup_district ? o.pickup_district + " · " : "" %><%= o.pickup_address %> · Destination: <%= o.dropoff_district %><%= o.dropoff_address ? " · " + o.dropoff_address : "" %></p><% if(o.status==='ASSIGNED' || o.status==='PICKING_UP'){ %><form method="post" action="/rider/orders/<%= o.id %>/<%= o.status==='ASSIGNED'?'depart':'pickup' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-primary"><%= o.status==='ASSIGNED'?'Depart for pickup':'Confirm pickup' %></button></form><% } %><% if(o.status==='PICKED_UP'){ %><form method="post" action="/rider/orders/<%= o.id %>/deliver" class="row g-2 mb-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="col-md-5"><select class="form-select" name="storage_point_id" required><option value="">Select storage point</option><% points.forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></div><div class="col-md-5"><input class="form-control" name="evidence" placeholder="Delivery evidence / receipt number" required></div><div class="col-md-2"><button class="btn btn-success w-100">Deliver</button></div></form><form method="post" action="/rider/orders/<%= o.id %>/fail" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="col-md-10"><input class="form-control" name="reason" placeholder="Failure reason" required></div><div class="col-md-2"><button class="btn btn-outline-danger w-100">Report failure</button></div></form><% } %><% if(o.status==='FAILED'){ %><p class="text-danger mb-0">Waiting for Dispatcher review.</p><% } %></section><% }) %><%- include('partials/foot') %>

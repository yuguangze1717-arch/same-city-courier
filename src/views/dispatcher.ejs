<%- include('partials/head') %><% orders.forEach(o=>{ %><section class="card card-body mb-3"><h2 class="h5"><%= o.tracking_no %> · <%= o.status %></h2><p>Current Rider: <%= o.rider_name || 'Unassigned' %></p><% if(['PAID','ASSIGNED','PICKING_UP'].includes(o.status)){ %><form method="post" action="/dispatcher/orders/<%= o.id %>/assign" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="col-md-4"><select class="form-select" name="rider_id" required><option value="">Select Rider</option><% riders.forEach(r=>{ %><option value="<%= r.id %>"><%= r.name %></option><% }) %></select></div><div class="col-md-5"><input class="form-control" name="reason" placeholder="Reason required for reassignment"></div><div class="col-md-3"><button class="btn btn-primary w-100"><%= o.status==='PAID'?'Assign':'Reassign' %></button></div></form><% } %><% if(o.status==='FAILED'){ %><form method="post" action="/dispatcher/orders/<%= o.id %>/resolve" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="col-md-3"><select class="form-select" name="resolution"><option value="DELIVERED">Confirm delivery</option><option value="CANCELLED">Cancel (refund pending)</option></select></div><div class="col-md-3"><select class="form-select" name="storage_point_id"><option value="">Storage point</option><% points.forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></div><div class="col-md-3"><input class="form-control" name="evidence" placeholder="Delivery evidence"></div><div class="col-md-3"><input class="form-control" name="reason" placeholder="Cancellation reason"></div><div class="col-12"><button class="btn btn-warning">Resolve failure</button></div></form><% } %></section><% }) %><%- include('partials/foot') %>

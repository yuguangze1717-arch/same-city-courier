<%- include('partials/head') %><form method="post" class="card card-body form-narrow"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="form-label">Name<input class="form-control" name="name" required></label><label class="form-label">Email<input class="form-control" name="email" type="email" required></label><label class="form-label">Phone<input class="form-control" name="phone" required></label><label class="form-label">Password (at least 8 characters)<input class="form-control" name="password" type="password" minlength="8" required></label><button class="btn btn-primary mt-3">Register</button></form><%- include('partials/foot') %>

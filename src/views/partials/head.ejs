<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> · Same-City Courier</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/style.css" rel="stylesheet">
</head>
<body>
  <nav class="app-nav">
    <div class="container nav-inner">
      <a class="navbar-brand" href="/">Same-City <span>Courier</span></a>
      <div class="nav-links">
        <a href="/">Track parcel</a>
        <% if(user){ %>
          <% [['Sender','/sender'],['Dispatcher','/dispatcher'],['Rider','/rider'],['Administrator','/admin']].forEach(([role,path])=>{ if(user.roles.includes(role)){ %>
            <a href="<%= path %>"><%= role==='Administrator'?'Admin':role %></a>
          <% } }) %>
          <form method="post" action="/logout" class="nav-auth">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn btn-sm btn-outline-primary">Log out</button>
          </form>
        <% } else { %>
          <a href="/register">Create account</a>
          <a href="/login" class="nav-auth btn btn-sm btn-outline-primary">Log in</a>
        <% } %>
      </div>
    </div>
  </nav>
  <main class="container app-main">
    <p class="page-kicker">HONG KONG SAME-CITY DELIVERY</p>
    <h1 class="mb-4"><%= title %></h1>

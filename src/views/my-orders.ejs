<%- include('partials/head') %>
<div class="page-actions"><a href="/sender">← Back to hub</a><a class="btn btn-primary" href="/sender/orders/new">Create order</a></div>
<form method="get" action="/sender/orders" class="card card-body order-search"><label for="order-search">Find an order by tracking number</label><div class="order-search-row"><input class="form-control" id="order-search" name="q" value="<%= query %>" placeholder="Enter all or part of a tracking number"><button class="btn btn-primary">Search</button></div></form>
<section class="card card-body"><h2 class="h5">Order history</h2><% if(!orders.length){ %><p class="text-muted mb-0"><%= query?'No matching orders found.':'No orders yet. Create your first order to get started.' %></p><% } else { %><div class="list-group list-group-flush"><% orders.forEach(o=>{ %><a class="list-group-item list-group-item-action order-item" href="/sender/orders/<%= o.id %>"><span><strong><%= o.tracking_no %></strong><small>Created <%= o.created_at %></small></span><span class="order-status"><%= o.status %> <span aria-hidden="true">→</span></span></a><% }) %></div><% } %></section>
<%- include('partials/foot') %>

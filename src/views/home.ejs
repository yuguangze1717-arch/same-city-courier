<%- include('partials/head') %><p>Recipients can track a parcel without an account using the tracking number and the last four digits of their phone number.</p><form method="post" action="/track" class="card card-body row g-3 mb-4"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="col-md-7"><label class="form-label" for="tracking_no">Tracking number</label><input class="form-control" id="tracking_no" name="tracking_no" required></div><div class="col-md-3"><label class="form-label" for="last_four">Phone last four digits</label><input class="form-control" id="last_four" name="last_four" pattern="[0-9]{4}" maxlength="4" required></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Track</button></div></form><% if(result){ %><section class="card card-body"><h2 class="h5"><%= result.tracking_no %> · <%= result.status %></h2><% if(result.point){ %><p>Storage point: <%= result.point.name %> · <%= result.point.address %></p><% } %><ol class="mb-0"><% result.events.forEach(e=>{ %><li><%= e.status %> · <%= e.created_at %></li><% }) %></ol></section><% } %><%- include('partials/foot') %>
